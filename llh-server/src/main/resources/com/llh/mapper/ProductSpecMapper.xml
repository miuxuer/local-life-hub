<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.llh.mapper.ProductSpecMapper">

    <!--添加规格-->
    <insert id="insertBatch">
        insert into product_spec (product_id, name, value)
        VALUES
        <foreach collection="specs" item="spec" separator=",">
            (#{spec.productId}, #{spec.name}, #{spec.value})
        </foreach>

    </insert>

    <!--批量删除商品规格-->
    <delete id="deleteByProductIds">
        delete from product_spec where product_id in
        <foreach collection="productIds" item="productId" separator="," open="(" close=")">
            #{productId}
        </foreach>
    </delete>


</mapper>
