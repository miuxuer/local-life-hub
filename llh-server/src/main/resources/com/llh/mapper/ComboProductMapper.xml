<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.llh.mapper.ComboProductMapper">

    <!--根据id查找套餐-->
    <select id="getComboIdsByProductIds" resultType="java.lang.Long">
        select product_id from combo_product where product_id in
            <foreach collection="productIds" item="productId" separator="," open="(" close=")">
                #{productId}
            </foreach>
    </select>

    <!--新增套餐与商品关系-->
    <insert id="insertBatch">
        insert into combo_product (combo_id, product_id, name, price, copies) VALUES
        <foreach collection="comboProducts" item="sd" separator=",">
            (#{sd.comboId}, #{sd.productId}, #{sd.name}, #{sd.price}, #{sd.copies})
        </foreach>
    </insert>

    <!--批量删除套餐-->
    <delete id="deleteByComboIds">
        delete from combo_product where combo_id in
            <foreach collection="comboIds" item="comboId" separator="," open="(" close=")">
                #{comboId}
            </foreach>
    </delete>



</mapper>
